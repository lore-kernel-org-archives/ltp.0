+	}
+
+	vars.a = getRand();
+	vars.b = getRand();
+	vars.c = getRand();
+
+	resTbl[atoi(arg)].locRes = vars.a + (vars.b * vars.c);
+
+	clnt_call((CLIENT *) clnt, CALCTHREADPROC, (xdrproc_t) xdr_datas, (char *)&vars,	// xdr_in
