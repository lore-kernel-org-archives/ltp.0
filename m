+	CLIENT *clnt = NULL;
+	struct datas vars;
+	static double result = 0;
+	struct timeval total_timeout;
+
+	total_timeout.tv_sec = 1;
+	total_timeout.tv_usec = 1;
+
+	clnt = clnt_create(hostname, progNum, VERSNUM, nettype);
+
