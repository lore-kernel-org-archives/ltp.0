+	madvise(page, PS, MADV_DONTNEED);
+
+	arg.page = page;
+	arg.msg  = "under io clean";
+	arg.mode = MREAD_OK;
+	if (setup_sniper(&arg) < 0)
+		return;
+
+	waitfor(WAITING, WAITING);
+	// what is correct here?
+	if (pread(fd, buf, 10, 0) != 0)
+		perror("pread under io clean");
