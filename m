+	int var_snd = 0;
+	int var_rec = -1;
+	struct timeval tv;
+
+	//Test initialisation
+	maxIter = atoi(argc[3]);
+	resultTbl = (double *)malloc(maxIter * sizeof(double));
+
+	tv.tv_sec = 0;
+	tv.tv_usec = 100;
+
+	nconf = getnetconfigent("udp");
+	if (nconf == (struct netconfig *)NULL) {
+		fprintf(stderr, "err nconf\n");
+		printf("5\n");
+		exit(5);
+	}
+
+	svcaddr.len = 0;
+	svcaddr.maxlen = ADDRBUFSIZE;
+	svcaddr.buf = addrbuf;
+
+	if (svcaddr.buf == NULL) {
+		printf("5\n");
+		exit(5);
+	}
+
+	if (!rpcb_getaddr(progNum, VERSNUM, nconf, &svcaddr, argc[1])) {
+		fprintf(stderr, "rpcb_getaddr failed!!\n");
+		printf("5\n");
+		exit(5);
+	}
+	//Call tested function several times
+	for (i = 0; i < maxIter; i++) {
+		//Tic
+		gettimeofday(&tv1, &tz);
+
+		//Call function
+		cs = rpcb_rmtcall(nconf, argc[1], progNum, VERSNUM, PROCNUM,
