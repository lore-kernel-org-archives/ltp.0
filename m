+if [ "$TESTWAY" = "onetomany" ]
+then
+	# run one server for one or more client
+	$REMOTESHELL $SERVERUSER@$SERVERIP "$TESTSERVER_1 $PROGNUMBASE"&
+else
+	# launch as much server instances as client instances
+	for ((a=0; a < TESTINSTANCE ; a++))
+	do
