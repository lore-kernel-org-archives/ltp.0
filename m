find . -type d -name .git -prune -o \
       -type f \! -name \*\~ \! -name .\#\* \
       \! -name \*.gz \! -name \*.pdf \! -name \*.patch -print0 | \
       xargs -0 sed -i -e 's/[\t ]*$//'

