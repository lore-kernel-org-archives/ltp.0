+		diff =
+		    (tv2.tv_sec - tv1.tv_sec) * 1000000L + (tv2.tv_usec -
+							    tv1.tv_usec);
+		rslt = (double)diff / 1000;
+		thread_time_result[i] = rslt;
+
+		curThd = curThd * 2;
+	}
+
+	//Check if all threads results are ok
+	test_status = 0;
+	for (i = 0; i < threadNb; i++) {
+		if (thread_time_result[i] == 0) {
