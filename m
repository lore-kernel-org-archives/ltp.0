+
+	svcaddr.len = 0;
+	svcaddr.maxlen = ADDRBUFSIZE;
+	svcaddr.buf = addrbuf;
+
+	if (svcaddr.buf == NULL) {
+		/* if malloc() failed, print error messages and exit */
+		printf("5\n");
+		exit(1);
