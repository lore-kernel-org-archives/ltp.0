> b/testcases/realtime/func/pi-tests/sbrk_mutex.c
> index 684021f..5c325b4 100644
> --- a/testcases/realtime/func/pi-tests/sbrk_mutex.c
> +++ b/testcases/realtime/func/pi-tests/sbrk_mutex.c
> @@ -45,7 +45,7 @@
>  #include <unistd.h>
