+/* Get the number of files */
+uint32_t get_listsize(struct benchfiles *bf)
+{
+	return bf->listsize;
+}
+
+/* Get the number of subdirectories */
+uint32_t get_numsubdirs(struct benchfiles *bf)
+{
+	return bf->numsubdirs;
+}
