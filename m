+
+	//Print scalability results
+	curThd = 1;
+	for (i = 0; i < threadNb; i++) {
+		printf("%d %lf\n", curThd, thread_time_result[i]);
+		curThd = curThd * 2;
+	}
+
+	return test_status;
+}
