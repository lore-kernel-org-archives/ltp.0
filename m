+		exit(5);
+	}
+
+	svcaddr.len = 0;
+	svcaddr.maxlen = ADDRBUFSIZE;
+	svcaddr.buf = addrbuf;
+
+	if (svcaddr.buf == NULL) {
+		printf("5\n");
+		exit(5);
+	}
+
