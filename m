+#define VERSNUM 1
+
+static double *thread_time_result;
+static int maxThd = 1;
+int run_mode;
+int progNum;
+int callNb;
+char *nettype = "visible";
+char *hostname;
+
+void *my_thread_process(void *arg)
+{
+	int i;
+	CLIENT *clnt = NULL;
+	int sndVar = 0;
+	int recVar = -1;
+	struct timeval total_timeout;
+
