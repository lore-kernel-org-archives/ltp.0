+	if [ "$1" = "TIRPC" ]
+	then
+		i=2
+		find ./ -name "*$2_lib.sh" | grep "tirpc" | while read fic
+		do
+			echo " "$i". "$fic | sed -e 's/\.\/tirpc_//g' | sed -e s/"_"$2"_lib.sh"//g
+			i=`expr $i + 1`
+			scat=( "${scat[@]}" "$(echo $fic | sed -e 's/\.\/tirpc_//g' | sed -e s/"_"$2"_lib.sh"//g)" )
