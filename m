+uint64_t ffsb_get_filesize(char *name)
+{
+#ifndef HAVE_STAT64
+ #define STAT(a, b) do { stat((a), (b)); } while (0)
+	struct stat filestat;
+#else
+ #define STAT(a, b) do { stat64((a), (b)); } while (0)
+	struct stat64 filestat;
+#endif
+
+
+	STAT(name, &filestat);
+	return (uint64_t)filestat.st_size;
+#undef STAT
+}
+
