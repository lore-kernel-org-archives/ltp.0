+	pthread_attr_setstacksize(&thread_attr, 40000);	//Set thread stack size to 40 KB
+
+	//Init results table
+	thread_time_result = (double *)malloc((threadNb) * sizeof(double));
+	memset(&thread_time_result[0], (double)0, (threadNb) * sizeof(double));
+
+	//Create all threads
