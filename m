+	int sndVar = 0;
+	int recVar;
+
+	if (run_mode == 1) {
+		fprintf(stderr, "Thread %d\n", atoi(arg));
+	}
+
+	for (i = 0; i < callNb; i++) {
+		rpc_broadcast_exp(progNum, VERSNUM, PROCNUM,
+				  (xdrproc_t) xdr_int, (char *)&sndVar,
+				  (xdrproc_t) xdr_int, (char *)&recVar,
+				  (resultproc_t) eachresult, 1, 1, nettype);
+	}
+
+	pthread_exit(0);
+}
