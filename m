 From efe86553599706258aca055fdcbb2caf31fee8b0 Mon Sep 17 00:00:00 2001
From: Soma Das <somadas1@linux.ibm.com>
Date: Sun, 12 Apr 2026 16:43:43 +0000
Subject: [PATCH] mmap: fix intermittent OOM kill of test parent in mmap22

The test forks a stress child inside a shared memcg (256 MB limit).
When the cgroup fills up the OOM killer sometimes picks the parent
(test harness) over the child (stress worker) because both have
oom_score_adj=0 and the kernel heuristics are non-deterministic.
This causes the test to crash or segfault instead of reporting a
clean result on ppc64le and other architectures.

Fix by adding a set_oom_score_adj() helper that writes directly to
/proc/self/oom_score_adj using open()/write() with a TWARN on
failure (rather than SAFE_FILE_PRINTF which would hard-abort the
test in restricted environments). Set the parent to -1000 before
fork() to protect the test harness, and set the child to +1000
immediately after fork() to make it the unambiguous OOM victim.
Add #include <fcntl.h> for O_WRONLY used by the helper.

Signed-off-by: Soma Das <somadas1@linux.ibm.com>
---
  testcases/kernel/syscalls/mmap/mmap22.c | 37 ++++++++++++++++++++++++-
  1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/testcases/kernel/syscalls/mmap/mmap22.c 
b/testcases/kernel/syscalls/mmap/mmap22.c
index 0b95c578f..02c363893 100644
--- a/testcases/kernel/syscalls/mmap/mmap22.c
+++ b/testcases/kernel/syscalls/mmap/mmap22.c
@@ -17,6 +17,7 @@
  #include <stdio.h>
  #include <sys/types.h>
  #include <sys/mman.h>
+#include <fcntl.h>
  #include <unistd.h>
  #include <signal.h>
  #include <sys/wait.h>
@@ -31,6 +32,24 @@ static struct tst_cg_group *cg_child;
  static pid_t child;
  static int page_size;

+static void set_oom_score_adj(int value)
+{
+    char buf[16];
+    int fd, len;
+
+    fd = open("/proc/self/oom_score_adj", O_WRONLY);
+    if (fd < 0) {
+        tst_res(TWARN | TERRNO, "Failed to open /proc/self/oom_score_adj");
+        return;
+    }
+
+    len = snprintf(buf, sizeof(buf), "%d", value);
+    if (write(fd, buf, len) != len)
+        tst_res(TWARN | TERRNO, "Failed to write oom_score_adj=%d", value);
+
+    close(fd);
+}
+
  static void stress_child(void)
  {
      for (;;) {
@@ -63,9 +82,25 @@ static void test_mmap(void)

      vec = SAFE_MALLOC(npages);

+    /*
+     * Protect the parent (test harness) from the OOM killer. Both parent
+     * and child share the same memcg, so without an explicit hint the OOM
+     * killer picks based on heuristics that can favour the parent.
+     */
+    set_oom_score_adj(-1000);
+
      child = SAFE_FORK();
-    if (!child)
+    if (!child) {
+        /*
+         * Make the child the preferred OOM victim. If OOM fires while
+         * the stress worker is filling memory, the kernel must kill the
+         * child (stress worker) and not the parent (test harness).
+         * oom_score_adj=1000 is the maximum, guaranteeing this process
+         * is chosen first within the cgroup.
+         */
+        set_oom_score_adj(1000);
          stress_child();
+    }

      for (;;) {
          if (!tst_remaining_runtime()) {
