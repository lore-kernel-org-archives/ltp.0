-			if (rc == -1) {
-				DMLOG_PRINT(DMLVL_ERR,
-					    "dm_set_disp failed! (rc = %d, errno = %d)\n",
-					    rc, errno);
-				dm_destroy_session(sid);
-				DM_EXIT();
-			}
-
-			rc = dm_set_eventlist(sid, lhanp, lhlen, token, &events,
-					      DM_EVENT_MAX);
-			if (rc == -1) {
-				DMLOG_PRINT(DMLVL_ERR,
-					    "dm_set_eventlist failed! (rc = %d, errno = %d)\n",
