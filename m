> +	++fw_num;
> +}
> +
> +static void test_run(void)
> +{
> +	/* initiate firmware requests */
> +	SAFE_FILE_PRINTF(cleanup, dev_fwnum, "%d", fw_num);
> +
> +	/* get module results by reading result bit mask */
> +	int result = 0;
> +	SAFE_FILE_SCANF(cleanup, dev_result, "%d", &result);
> +
