-#-----------------------------------------------------------------------
-
-RC=0
-do_setup
-test_body 1 || RC=`expr $RC + 1`	# Case of ifconfig command
-test_body 2 || RC=`expr $RC + 1`	# Case of ip command
-do_cleanup
-
-exit $RC
