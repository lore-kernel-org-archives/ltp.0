+bool_t xdr_datas(XDR * pt_xdr, struct datas *pt)
+{
+	return (xdr_double(pt_xdr, &(pt->a)) &&
+		xdr_double(pt_xdr, &(pt->b)) && xdr_double(pt_xdr, &(pt->c)));
+}
+
+double getRand()
+{
+	return (drand48() * 1000);
+}
