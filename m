+
+	sprintf(buf, "%s%d/%s%c", PROCFS_PATH, pid, AFFINITY_NAME, 0);
+
+	if((pfile=fopen(buf, "r"))==NULL)
+		return 0;
+
+	if(fgets(buf, 255, pfile)==NULL)
+	{
+		fclose(pfile);
+		return 0;
+	}
+
+	fclose(pfile);
+
+	return atol(buf);
+}
+
+int HT_GetAffinity()
+{
+	unsigned long mask, mask1;
+	pid_t pid;
+
+	mask=0x1;
+	pid=getpid();
+
+	tst_resm(TINFO, "Get affinity through system call.\n");
+
+	sched_setaffinity(pid, sizeof(unsigned int), &mask);
+
+	sleep(1);
+
+	sched_getaffinity(pid, sizeof(unsigned int), &mask1);
+
+	if (mask == 0x1 && mask == mask1)
+	{
+		mask=0x2;
+		sched_setaffinity(pid, sizeof(unsigned long), &mask);
+
+		sleep(1);
+
+		sched_getaffinity(pid, sizeof(unsigned int), &mask1);
+
+		if (mask == 0x2 && mask == mask1)
+			return 1;
+		else
+			return 0;
+	}
+	else
+		return 0;
+}
+
+int HT_InheritAffinity()
+{
+	unsigned long mask;
+	pid_t pid;
+
+	mask=0x2;
+	pid=getpid();
+
+	tst_resm(TINFO, "Inherit affinity from parent process.\n");
+
+	sched_setaffinity(pid, sizeof(unsigned int), &mask);
+
+	sleep(1);
+
+	if((pid=fork())==0)
+	{
+		sleep(1);
+		system("ps > /dev/null");
+		exit(0);
+	}
+
+	sched_getaffinity(pid, sizeof(unsigned int), &mask);
+
+	if(mask==0x2)
+		return 1;
+	else
+		return 0;
+}
+
