+		exit(5);
+	}
+
+	client = clnt_tli_create(RPC_ANYFD, nconf, &svcaddr,
+				 progNum, VERSNUM, 0, 0);
+
+	if (client == NULL) {
+		printf("5\n");
+		exit(5);
+	}
+
+	for (i = 0; i < callNb; i++) {
+		clnt_call(client, PROCNUM,
+			  (xdrproc_t) xdr_int, (char *)&var_snd,
+			  (xdrproc_t) xdr_int, (char *)&var_rec, tv);
+	}
+
+	clnt_destroy(client);
+
+	pthread_exit(0);
+}
