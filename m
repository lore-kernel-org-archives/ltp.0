+		rpc_call(hostname, progNum, VERSNUM, PROCNUM, (xdrproc_t) xdr_int, (char *)&sndVar,	// xdr_in
+			 (xdrproc_t) xdr_int, (char *)&recVar,	// xdr_out
+			 nettype);
+	}
+
+	pthread_exit(0);
+}
