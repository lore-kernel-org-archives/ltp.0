+		  total_timeout);
+
+	thread_array_result[atoi(arg)] =
+	    (resTbl[atoi(arg)].svcRes == resTbl[atoi(arg)].locRes) ? 0 : 1;
+
+	if (run_mode == 1) {
+		fprintf(stderr, "Thread #%d calc : %lf, received : %lf\n",
+			atoi(arg), resTbl[atoi(arg)].locRes,
