+static char *get_next_line(FILE *f)
+{
+	static char buf[BUFSIZE];
+	char *ret, *tmp;
+	int flag = 1;
+	while (flag) {
+		ret = fgets(buf, BUFSIZE, f);
+		if (ret == NULL)
+			return NULL;
+		ret = buf;
+		while (isspace(*ret))
+			ret++;
+
+		if ((*ret == COMMENT_CHAR) || (*ret == '\0'))
+			continue;
+
+		tmp = ret;
+		while (*tmp != '\0') {
+			if (*tmp == COMMENT_CHAR) {
+				*tmp = '\0';
+				break;
+			}
+			tmp++;
+		}
+		flag = 0;
+	}
+	return ret;
+}
+
+static char *strip_space(char *buf)
+{
+	int len;
+	char *tmp, *tmp2;
+	int flag = 1;
+
+	len = strnlen(buf, BUFSIZE);
+	tmp = malloc(sizeof(char) * len);
+	memset(tmp, 0, sizeof(char) * len);
+	tmp2 = tmp;
+	while (flag) {
+		if (!isspace(*buf)) {
+			*tmp = *buf;
+			tmp++;
+		}
+		buf++;
+		if (*buf != '\0')
+			continue;
+		flag = 0;
+	}
+	return tmp2;
+}
