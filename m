+	SVCXPRT *svcr = NULL;
+	int rslt;
+
+	//Initialisation
+	pmap_unset(progNum, VERSNUM);
+	//create a server
+	svcr = svcudp_create(RPC_ANYSOCK);
+
+	//call routine
+	rslt =
