+void ffsb_sync()
+{
+	struct timeval starttime, endtime, difftime;
+	printf("Syncing()...");
+	fflush(stdout);
+	gettimeofday(&starttime, NULL);
+	sync();
+	gettimeofday(&endtime, NULL);
+	timersub(&endtime, &starttime, &difftime);
+	printf("%ld sec\n", difftime.tv_sec);
+}
