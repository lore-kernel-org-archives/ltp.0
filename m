+static int tmpcount;
+int tempfd(void)
+{
+	int fd;
+	char buf[PATHBUFLEN];
+	snprintf(buf, sizeof buf, TMPDIR "poison%d",tmpcount++);
+	fd = open(buf, O_CREAT|O_RDWR, 0600);
+	if (fd >= 0)
+		unlink(buf);
+	if (fd < 0)
+		err("opening temporary file in " TMPDIR);
+	return fd;
