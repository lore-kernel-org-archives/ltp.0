-if [ $NO_NETWORK -eq 0 ];then
-  # Networking setup
-  echo `hostname` >> /root/.rhosts
-  chmod 644 /root/.rhosts
-
-  netstat -an | grep 514
-  if [ $? -eq 1 ];then
-    echo "Error: 'rsh' daemon not active on this machine."
