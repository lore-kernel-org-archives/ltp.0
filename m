+#include <utmp.h>
+
+//Standard define
+#define PROCNUM 1
+#define VERSNUM 1
+
+char *simplePing(char *i_var)
+{
+	//Simple function, returns what received
+	static int result = 0;
+	result = *i_var;
+	return (char *)&result;
