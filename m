!/bin/bash

ulimit -c unlimited

i=0
while [ $i -lt 100 ]; do
	./clone03 &
	usleep 500
	kill $!
	i=$((i+1))
	ls core.* > /dev/null 
	if [ $? -eq 0 ]; then
		break;
	fi
done


