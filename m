-		if (response != DM_RESP_INVALID) {
-			DMLOG_PRINT(DMLVL_DEBUG,
-				    "Responding to message %d with %d\n", type,
-				    response);
-			rc = dm_respond_event(sid, token, response,
-					      response ==
-					      DM_RESP_ABORT ? ABORT_ERRNO : 0,
-					      0, NULL);
-		}
-	} while (bMounted);
-
-	pthread_exit(0);
-}
