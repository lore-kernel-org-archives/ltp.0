The following patch fixes the problem but I'm not very knowledgeable
on what fork13 does so this patch might not be a good approach.  Can
someone more knowledgeable on it let me know if this is a valid
approach?


  --- fork13.c~org	2012-01-12 17:18:19.464268246 +0000
+++ fork13.c	2012-01-12 17:32:18.724288274 +0000
@@ -69,6 +69,7 @@
 static int pid_distance(pid_t first, pid_t second);
 static void cleanup(void);
 static void check(void);
+void sighandler(int sig);

 int main(int argc, char* argv[])
 {
@@ -133,6 +134,20 @@
 	tst_resm(TPASS, "%ld pids forked, all passed", lc);
 }

+
+/*
+ * sighandler() - catch sigsegv when generated by child in test #4
+ */
+void sighandler(int sig)
+{
+
+ //  Handle SIGTERM
+    if (sig != SIGTERM) {
+        tst_brkm(TBROK, NULL, "caught unexpected signal: %d", sig);
+    }
+    _exit(0);
+}
+
 void setup(void)
 {
 	FILE *fp;
@@ -141,7 +156,7 @@

 	tst_require_root(NULL);

-	tst_sig(FORK, DEF_HANDLER, cleanup);
+	tst_sig(FORK, sighandler, cleanup);
 	TEST_PAUSE;
 	/* Backup pid_max value. */
 	fp = fopen(PATH, "r+");

