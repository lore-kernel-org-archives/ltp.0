+	dblSnd = -1735.63000f;
+
+	rpc_broadcast(progNum, VERSNUM, DBLPROCNUM,
+		      (xdrproc_t) xdr_double, (char *)&dblSnd,
+		      (xdrproc_t) xdr_double, (char *)&dblRec,
